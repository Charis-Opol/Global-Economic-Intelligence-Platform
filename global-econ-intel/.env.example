# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# ---- Postgres (shared metadata store: airflow / mlflow / superset) ----
POSTGRES_USER=platform
POSTGRES_PASSWORD=change_me

# ---- Airflow ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_a_real_fernet_key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# ---- MinIO (Bronze / Silver / Gold object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=http://minio:9000

# ---- Superset ----
SUPERSET_SECRET_KEY=change_me_generate_a_long_random_string

# ---- External API keys (used by connectors in a later step, not yet wired) ----
NEWSAPI_KEY=

# ---- Backend JWT auth (Day 2, Step 7) ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_long_random_string
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change_me
