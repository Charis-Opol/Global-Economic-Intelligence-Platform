# Local (non-Docker) dev only - copy to backend/.env and run from inside
# backend/ (e.g. `cd backend && uvicorn app.main:app --reload`).
# docker-compose.yml sets all of this itself for the containerized stack;
# this file exists for the workflow in the root README's
# "Running locally without Docker" section instead.

# Points at the warehouse file scripts/load_local_demo_data.py (run from the
# repo root) writes to by default.
DUCKDB_PATH=../warehouse/warehouse.duckdb

# A local sqlite file, not the real mlflow:5000 server - sqlite "connects"
# instantly (it's just a file), so /models returns an empty list instead of
# the backend raising because nothing's listening at that hostname. Point
# this at a real MLflow server if you want /models and /predictions to
# return actual registered models.
MLFLOW_TRACKING_URI=sqlite:///../mlflow-local/mlflow.db

# Matches Vite's default dev server port - change if you're running the
# frontend somewhere else.
CORS_ALLOWED_ORIGINS=http://localhost:5173

AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change_me
# Any random string is fine for local dev - it only needs to be consistent
# for the lifetime of this process. Generate a real one for anything shared:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=local-dev-secret-key-not-for-production

# Airflow/Superset aren't running in this workflow - both /pipeline-status
# and /superset/guest-token already handle that unreachability gracefully
# (null state / 502), so there's nothing to set here unless you also stood
# those services up separately.
